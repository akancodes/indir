{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "indir",
  "identifier": "dev.akan.indir",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bayram Akan",
    "copyright": "© 2026 Bayram Akan",
    "homepage": "https://github.com/akancodes/indir",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "A tiny download manager",
    "longDescription": "indir downloads a file over several connections at once, so it arrives sooner, and can pause and resume it, even after a restart. Paste a link and that's all there is to it.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
